# Never commit a real key. In production use OPENAI_API_KEY_FILE instead.
OPENAI_API_KEY_FILE=/etc/calltranslate/openai_api_key
ROOM_SIGNING_SECRET=replace-with-a-long-random-value
ROOM_ADMIN_TOKEN=replace-with-a-separate-long-random-value
PUBLIC_BASE_URL=https://your-call-domain.example
ROOM_TTL_SECONDS=21600
ROOM_ACCESS_TTL_SECONDS=2700
MAX_CALL_SECONDS=1800
OPENAI_CLIENT_SECRET_TTL_SECONDS=60
REALTIME_CALL_COOLDOWN_SECONDS=5
REALTIME_CALL_MAX_GRANTS=3

# Optional TURN configuration for difficult mobile/Wi-Fi networks.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_SHARED_SECRET=
